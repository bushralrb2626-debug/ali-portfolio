# =============================================================================
# Free cloud MySQL (Aiven) — accessible from this PC, other PCs, and Render
# =============================================================================
# Setup (once, $0, no credit card):
# 1. Sign up at https://aiven.io (GitHub or Google)
# 2. Create service → MySQL → plan "Free"
# 3. Wait until status is Running
# 4. Open the service → Connection information
# 5. Copy host, port, user, password, database (usually defaultdb)
# 6. Paste into DATABASE_URL below (and the same value on Render → Environment)
#
# Prisma / Aiven SSL: use sslaccept=strict (do NOT use ssl-mode=REQUIRED — Prisma rejects it)
DATABASE_URL="mysql://avnadmin:PASSWORD@HOST:12345/defaultdb?sslaccept=strict"

AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
ADMIN_EMAIL="alimasterofall105@gmail.com"
ADMIN_PASSWORD="12345"
# Inbox for contact/booking/report alerts (defaults to ADMIN_EMAIL / alimasterofall105@gmail.com)
ADMIN_NOTIFY_EMAIL="alimasterofall105@gmail.com"
# Mail transport — pick one:
# RESEND_API_KEY="re_..."
# RESEND_FROM="Portfolio <you@yourdomain.com>"
# Or Gmail SMTP (App Password):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="alimasterofall105@gmail.com"
# SMTP_PASS="your-gmail-app-password"
# SMTP_FROM="Ali Portfolio <alimasterofall105@gmail.com>"
# Campus bot (Cursor SDK) — https://cursor.com/dashboard/integrations
CURSOR_API_KEY="cursor_..."
# Optional model id (default auto — server picks)
# CURSOR_BOT_MODEL="auto"

# Slorsh billing → School Desk CSR bot (Agency rates).
# If SLORSH_USAGE_SECRET is empty, portfolio uses the same built-in bridge secret as Slorsh.
SLORSH_API_BASE="https://ramuza.onrender.com/api/v1"
SLORSH_USAGE_SECRET=
