# =============================================================================
# Aiven PostgreSQL — use your $50 trial (NOT the Free tier)
# Accessible from this PC, other PCs, and Render
# =============================================================================
# Why not Free? Free auto-powers off when inactive and has no pooling.
# Spend trial credits on a small paid plan so the DB stays online.
#
# Setup:
# 1. console.aiven.io → Create new service → PostgreSQL (first card on the list)
# 2. Service tier: pick the cheapest PAID plan (Startup / Hobby — NOT "Free")
#    → uses your $50 trial credits (~weeks of always-on DB)
# 3. Cloud region: pick one close to you / Render (e.g. google-asia or aws nearby)
# 4. Create service → wait until Running
# 5. Overview → Connection information → copy URI (or host/port/user/password)
# 6. Paste into DATABASE_URL below AND Render → Environment → DATABASE_URL
# 7. Locally: npx prisma db push
#
# Prisma SSL for Postgres: sslmode=require
DATABASE_URL="postgres://avnadmin:PASSWORD@HOST:12345/defaultdb?sslmode=require"

AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
ADMIN_EMAIL="alimasterofall105@gmail.com"
ADMIN_PASSWORD="12345"
# Inbox for contact/booking/report alerts (defaults to ADMIN_EMAIL / alimasterofall105@gmail.com)
ADMIN_NOTIFY_EMAIL="alimasterofall105@gmail.com"
# Mail transport — pick one:
# RESEND_API_KEY="re_..."
# RESEND_FROM="Portfolio <you@yourdomain.com>"
# Or Gmail SMTP (App Password):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="alimasterofall105@gmail.com"
# SMTP_PASS="your-gmail-app-password"
# SMTP_FROM="Ali Portfolio <alimasterofall105@gmail.com>"
# Campus bot (Cursor SDK) — https://cursor.com/dashboard/integrations
CURSOR_API_KEY="cursor_..."
# Optional model id (default auto — server picks)
# CURSOR_BOT_MODEL="auto"

# Slorsh billing (same PORTFOLIO_USAGE_SECRET as Render Slorsh API)
SLORSH_API_BASE="https://ramuza.onrender.com/api/v1"
SLORSH_USAGE_SECRET="shared-secret-with-slorsh"
